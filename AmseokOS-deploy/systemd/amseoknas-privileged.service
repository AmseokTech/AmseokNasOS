#--------------------------#
#--------隔离受限系统查询、网络配置与 RAID 白名单守护进程---------#
#--------Isolates constrained inventory, network, and RAID whitelist actions--------#
#-------------------------#
[Unit]
Description=AmseokOS constrained privileged system daemon
After=local-fs.target modprobe@md_mod.service systemd-networkd.service
Wants=modprobe@md_mod.service

[Service]
Type=simple
# mdadm 的 MD ioctl 和块设备写入必须由受 capability/systemd 双重约束的 root 进程执行
User=root
Group=amseoknas
UMask=0007
EnvironmentFile=/etc/amseoknas/privileged.env
# 网络写入只认 systemd-networkd 的受管目录，不能由调用方选择其他路径
Environment=AMSEOKNAS_PRIVILEGED_NETWORK_CONFIG_DIRECTORY=/etc/systemd/network
Environment=AMSEOKNAS_RAID_OPERATION_REGISTRY_PATH=/var/lib/amseoknas/raid/operations.json
Environment=AMSEOKNAS_RAID_BACKUP_DIRECTORY=/var/lib/amseoknas/raid/reshape
Environment=AMSEOKNAS_STORAGE_OPERATION_REGISTRY_PATH=/var/lib/amseoknas/storage/operations.json
Environment=AMSEOKNAS_STORAGE_DESCRIPTOR_DIRECTORY=/var/lib/amseoknas/storage/volumes
Environment=AMSEOKNAS_VOLUME_ROOT=/srv/amseoknas/volumes
Environment=AMSEOKNAS_MOUNT_UNIT_DIRECTORY=/etc/systemd/system
Environment=AMSEOKNAS_SAMBA_CONFIG=/etc/samba/smb.conf
Environment=AMSEOKNAS_SAMBA_INCLUDE_DIRECTORY=/etc/samba/smb.conf.d
Environment=AMSEOKNAS_NFS_EXPORT_DIRECTORY=/etc/exports.d
RuntimeDirectory=amseoknas
RuntimeDirectoryMode=0750
StateDirectory=amseoknas/raid amseoknas/storage
StateDirectoryMode=0700
ExecStart=/usr/libexec/amseoknas/amseoknas-privileged
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=block-* rwm
DeviceAllow=/dev/md-control rw
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# 严格系统保护保持开启，只放行受管网络、RAID、数据卷、mount unit 与共享配置目录
ReadWritePaths=/run/amseoknas /etc/systemd/network /var/lib/amseoknas/raid /var/lib/amseoknas/storage /var/lib/nfs /srv/amseoknas/volumes /etc/systemd/system /etc/samba /etc/exports.d
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# CAP_SYS_ADMIN/CAP_SYS_RAWIO 仅供固定 mdadm 动作和块设备复核；CAP_MKNOD 供 md 设备节点建立
# 写入目标仍受协议白名单、稳定身份复核、DevicePolicy 与 ReadWritePaths 共同限制
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_MKNOD
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_MKNOD
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
