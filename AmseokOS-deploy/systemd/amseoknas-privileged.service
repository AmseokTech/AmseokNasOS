#--------------------------#
#--------隔离受限系统查询、网络配置与 RAID 白名单守护进程---------#
#--------Isolates constrained inventory, network, and RAID whitelist actions--------#
#-------------------------#
[Unit]
Description=AmseokOS constrained privileged system daemon
After=local-fs.target modprobe@md_mod.service systemd-networkd.service
Wants=modprobe@md_mod.service

[Service]
Type=simple
# mdadm 的 MD ioctl 和块设备写入必须由受 capability/systemd 双重约束的 root 进程执行
User=root
Group=amseoknas
UMask=0007
EnvironmentFile=/etc/amseoknas/privileged.env
# 网络写入只认 systemd-networkd 的受管目录，不能由调用方选择其他路径
Environment=AMSEOKNAS_PRIVILEGED_NETWORK_CONFIG_DIRECTORY=/etc/systemd/network
Environment=AMSEOKNAS_RAID_OPERATION_REGISTRY_PATH=/var/lib/amseoknas/raid/operations.json
Environment=AMSEOKNAS_RAID_BACKUP_DIRECTORY=/var/lib/amseoknas/raid/reshape
RuntimeDirectory=amseoknas
RuntimeDirectoryMode=0750
StateDirectory=amseoknas/raid
StateDirectoryMode=0700
ExecStart=/usr/libexec/amseoknas/amseoknas-privileged
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=block-* rwm
DeviceAllow=/dev/md-control rw
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# 严格系统保护保持开启，只额外放行 Socket、网络配置与 RAID 私有状态目录
ReadWritePaths=/run/amseoknas /etc/systemd/network /var/lib/amseoknas/raid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# CAP_SYS_ADMIN/CAP_SYS_RAWIO 仅供固定 mdadm 动作和块设备复核；CAP_MKNOD 供 md 设备节点建立
# 写入目标仍受协议白名单、稳定身份复核、DevicePolicy 与 ReadWritePaths 共同限制
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_MKNOD
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_MKNOD
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
