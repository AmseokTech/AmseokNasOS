{
  "ConnectionStrings": {
    "ClusterDatabase": "Host=127.0.0.1;Port=5432;Database=amseoknas;Username=amseoknas",
    "NodeDatabase": "Data Source=./data/amseoknas-node.db;Foreign Keys=True"
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": false
  },
  "DataProtection": {
    "ApplicationName": "AmseokOS.ControlPlane",
    "CertificatePath": "/etc/amseoknas/data-protection/certificate.pem",
    "PrivateKeyPath": "/etc/amseoknas/data-protection/private-key.pem"
  },
  "ClusterServices": {
    "EtcdHealthUrl": "http://127.0.0.1:2379/health",
    "NatsHealthUrl": "http://127.0.0.1:8222/healthz?js-enabled-only=true"
  },
  "Terminal": {
    "Enabled": false,
    "SocketPath": "/run/amseoknas-terminal/terminal.sock",
    "AllowedOrigins": [],
    "PendingSessionLifetimeSeconds": 30,
    "IdleTimeoutMinutes": 15,
    "MaximumSessionMinutes": 60
  },
  "Privileged": {
    "Enabled": false,
    "SocketPath": "/run/amseoknas/privileged.sock",
    "TimeoutSeconds": 5,
    "RaidTimeoutSeconds": 60
  },
  "AppStore": {
    "Enabled": true,
    "BaseUrl": "https://download.amseok.cn/",
    "ChannelPath": "manifests/v1/channels/stable/current.json",
    "RefreshSeconds": 30,
    "TimeoutSeconds": 10,
    "MaximumDocumentBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
